{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "email-classification-service/app",
    "type": "project",
    "description": "Serviço single-tenant para captura e classificação de e-mails Gmail.",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "firebase/php-jwt": "^7.0",
        "google/apiclient": "^2.20",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpunit/phpunit": "^13.3.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear",
            "@pest"
        ],
        "pest": "@php vendor/bin/pest --testsuite=Unit,Feature,Integration,Contract,BDD,Architecture --parallel --processes=2",
        "larastan": "@php vendor/bin/phpstan analyse --no-progress",
        "infection": "@php vendor/bin/infection --threads=1 --no-progress",
        "quality-gate": [
            "@pest",
            "@larastan",
            "@infection"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "process-timeout": 1800,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
